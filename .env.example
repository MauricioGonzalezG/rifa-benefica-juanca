# URL y token de tu base de datos Turso. Solo se utilizan en el servidor.
TURSO_DATABASE_URL=libsql://TU-BASE-TU-ORGANIZACION.turso.io
TURSO_AUTH_TOKEN=

# Clave compartida para habilitar la edición en cada dispositivo (mínimo 16 caracteres).
# Elige una clave única y larga. No es tu contraseña de Turso.
ADMIN_PASSWORD=
